-    nfa_thread_T        *thread;
-    int                 i;
-
-    for (i = 0; i < l->n; ++i)
-    {
-        thread = &l->t[i];
-        if (thread->state->id == state->id && sub_equal(&thread->subs.norm, &subs->norm) && pim_equal(&thread->pim, pim))
-        {
-            return TRUE;
-        }
-    }
